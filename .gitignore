# --------------------------------------------------------------------------
# AssetSys - Git Ignore
# --------------------------------------------------------------------------

# Environment / secrets
.env
.env.*
!.env.example

# Composer dependencies
/vendor/

# Runtime storage
/storage/

# Runtime logs
*.log

# Database dumps / backups
*.sql
*.sql.gz
*.bak
*.backup

# Generated reports / exports
*.pdf
*.xlsx
*.xls
*.csv

# Local IDE / editor files
.vscode/
.idea/
*.code-workspace

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~

# PHP / application cache
/cache/
/tmp/

# PHPUnit / test artifacts
.phpunit.result.cache
coverage/

# Local development files
docker-compose.override.yml
# NIIMBOT local Python environments
# Local NIIMBOT printer tooling and test artifacts
/tools/niimbot/niimprintx/
/tools/niimbot/patch-work/
/tools/niimbot/.venv/
/tools/niimbot/.venv311/
/tools/niimbot/printer.py.b1-working
/tools/niimbot/printer.py.before-b1-fix
/tools/niimbot/test-label.png
/tools/niimbot/*.log
