# --------------------------------------------------------------------------
# AssetSys Environment Configuration
# --------------------------------------------------------------------------

# Application
APP_NAME="Company Asset Management System"
APP_ENV=production
APP_URL=http://localhost/AssetSys

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=assetsys
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password


# Active Administrator account used to audit automated depreciation entries
DEPRECIATION_AUTOMATION_USER_ID=

# Password Reset Email (SMTP)
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Company Asset Management System"

# Password reset link lifetime in minutes
PASSWORD_RESET_TTL_MINUTES=30

# Session / Security
SESSION_NAME=assetsys_session
CSRF_TOKEN_NAME=assetsys_csrf

# Optional application settings
APP_DEBUG=false

# Uploads
UPLOAD_MAX_SIZE=10485760